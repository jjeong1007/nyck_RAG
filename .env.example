# Anthropic (Claude Haiku for generation)
ANTHROPIC_API_KEY=

# OpenAI (text-embedding-3-small for embeddings)
OPENAI_API_KEY=

# Pinecone (serverless vector DB)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=company-rag
# Optional Pinecone namespace (must match ingest). Default is the blank namespace.
# PINECONE_NAMESPACE=
# Optional: limit how many vectors /sources scans (omit = scan entire index).
# SOURCE_INVENTORY_MAX_VECTORS=25000

# Notion (page/database ingestion + ticket write-back)
# Some tools also read NOTION_INTEGRATION_TOKEN — same secret as NOTION_TOKEN.
NOTION_TOKEN=
NOTION_TICKET_DB_ID=
# If the ticket database has multiple Notion "data sources", set the UUID for the
# source rows should be created in (Notion: database ⋯ → Manage data sources → Copy data source ID).
# NOTION_TICKET_DATA_SOURCE_ID=

# --- Product Roadmap write-back (Category + Ovr Status + numeric Prio) ---
# NOTION_TICKET_FORMAT=roadmap
# Must match an existing option on your Ovr Status property (spelling/caps).
# NOTION_ROADMAP_OVR_STATUS_OPTION=To be described
# NOTION_ROADMAP_DEFAULT_EPIC=Your Epic Name
# Fallback when the model leaves current_sprint empty (optional):
# NOTION_ROADMAP_DEFAULT_CURRENT_SPRINT=Sprint 12
# Model fills current_sprint when NOTION_ROADMAP_SPRINT_OPTIONS lists exact Notion select names:
# NOTION_ROADMAP_SPRINT_OPTIONS=Sprint 12,Sprint 13,Backlog
# JSON map: display name (or email) → Notion user id for Dev Owner (people property).
# Model outputs dev_owner matching one of the keys; add every person you might assign:
# NOTION_ROADMAP_PEOPLE_MAP={"Jason":"<uuid>","Ganesh":"<uuid>","Marc":"<uuid>","Ganesh Raj":"<uuid>"}
# Fallback owner(s) when dev_owner is empty (comma-separated UUIDs):
# NOTION_ROADMAP_DEV_OWNER_IDS=uuid-of-notion-user
# NOTION_ROADMAP_DEFAULT_ENG_DUE=2026-05-15

# Optional: classic schema column renames only (when NOTION_TICKET_FORMAT is unset/classic)
# NOTION_PROP_NAME=Name
# NOTION_PROP_TYPE=Type
# NOTION_PROP_PRIORITY=Priority
# NOTION_PROP_STATUS=Status
# NOTION_PROP_EFFORT=Estimated Effort
# NOTION_PROP_TAGS=Tags
